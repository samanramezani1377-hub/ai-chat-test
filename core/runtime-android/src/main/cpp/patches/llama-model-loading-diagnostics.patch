diff --git a/src/llama.cpp b/src/llama.cpp
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -320,50 +320,62 @@ static std::pair<int, llama_model *> llama_model_load(struct gguf_context * metadata, llama_model_set_tensor_data_t set_tensor_data, void * set_tensor_data_ud,
 
         ml.print_info();
+        LLAMA_LOG_INFO("ANDROID_DIAG_MODEL_CREATE_BEGIN\n");
         std::unique_ptr<llama_model> model_ptr(llama_model_create(ml, params));
+        LLAMA_LOG_INFO("ANDROID_DIAG_MODEL_CREATE_RETURN ptr=%p\n", (void *) model_ptr.get());
 
         bool ok = llama_prepare_model_devices(params, model_ptr.get());
+        LLAMA_LOG_INFO("ANDROID_DIAG_PREPARE_DEVICES_RETURN ok=%d\n", ok ? 1 : 0);
         if (!ok) {
             return {-1, nullptr};
         }
 
         auto * model = dynamic_cast<llama_model_base *>(model_ptr.get());
         if (model == nullptr) {
             GGML_ABORT("fatal error: model does not implement llama_model_base");
         }
 
         // loading time will be recalculated after the first eval, so
         // we take page faults deferred by mmap() into consideration
         model->t_load_us = 0;
         time_meas tm(model->t_load_us);
 
         model->t_start_us = tm.t_start_us;
 
         model->hparams.vocab_only = params.vocab_only;
         model->hparams.no_alloc   = params.no_alloc;
 
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_HPARAMS_BEGIN\n");
         try {
             model->load_hparams(ml);
         } catch(const std::exception & e) {
             throw std::runtime_error("error loading model hyperparameters: " + std::string(e.what()));
         }
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_HPARAMS_RETURN\n");
         if (model->arch == LLM_ARCH_CLIP) {
             throw std::runtime_error("CLIP cannot be used as main model, use it with --mmproj instead");
         }
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_VOCAB_BEGIN\n");
         try {
             model->load_vocab(ml);
         } catch(const std::exception & e) {
             throw std::runtime_error("error loading model vocabulary: " + std::string(e.what()));
         }
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_VOCAB_RETURN\n");
 
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_STATS_BEGIN\n");
         model->load_stats(ml);
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_STATS_RETURN\n");
         model->print_info();
+        LLAMA_LOG_INFO("ANDROID_DIAG_PRINT_INFO_RETURN\n");
 
         if (params.vocab_only) {
             LLAMA_LOG_INFO("%s: vocab only - skipping tensors\n", __func__);
             return {0, model_ptr.release()};
         }
 
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_TENSORS_BEGIN\n");
         if (!model->load_tensors(ml)) {
+            LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_TENSORS_RETURN false\n");
             return {-2, nullptr};
         }
+        LLAMA_LOG_INFO("ANDROID_DIAG_LOAD_TENSORS_RETURN true\n");
 
         return {0, model_ptr.release()};
     } catch (const std::exception & err) {
         LLAMA_LOG_ERROR("%s: error loading model: %s\n", __func__, err.what());
         return {-1, nullptr};
     }
 }
