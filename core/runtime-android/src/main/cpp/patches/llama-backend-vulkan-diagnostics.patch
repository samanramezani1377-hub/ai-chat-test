diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -250,10 +250,16 @@ void ggml_backend_tensor_set_async(ggml_backend_t backend, struct ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     GGML_ASSERT(tensor->data != NULL && "tensor not allocated");
     GGML_ASSERT(offset + size <= ggml_nbytes(tensor) && "tensor write out of bounds");
 
+    fprintf(stderr, "AI_CHAT_BACKEND_ASYNC_SET_BEGIN backend=%s tensor=%s offset=%zu size=%zu\n", ggml_backend_name(backend), ggml_get_name(tensor), offset, size);
     if (backend->iface.set_tensor_async == NULL) {
         ggml_backend_synchronize(backend);
         ggml_backend_tensor_set(tensor, data, offset, size);
     } else {
         backend->iface.set_tensor_async(backend, tensor, data, offset, size);
     }
+    fprintf(stderr, "AI_CHAT_BACKEND_ASYNC_SET_RETURNED backend=%s tensor=%s offset=%zu size=%zu\n", ggml_backend_name(backend), ggml_get_name(tensor), offset, size);
 }
@@ -337,6 +343,8 @@ void ggml_backend_tensor_set(struct ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     GGML_ASSERT(tensor->data != NULL && "tensor not allocated");
     GGML_ASSERT(offset + size <= ggml_nbytes(tensor) && "tensor write out of bounds");
 
+    fprintf(stderr, "AI_CHAT_BACKEND_SET_BEGIN tensor=%s offset=%zu size=%zu\n", ggml_get_name(tensor), offset, size);
     buf->iface.set_tensor(buf, tensor, data, offset, size);
+    fprintf(stderr, "AI_CHAT_BACKEND_SET_RETURNED tensor=%s offset=%zu size=%zu\n", ggml_get_name(tensor), offset, size);
 }
@@ -405,6 +413,8 @@ void ggml_backend_synchronize(ggml_backend_t backend) {
     if (backend->iface.synchronize == NULL) {
         return;
     }
 
+    fprintf(stderr, "AI_CHAT_BACKEND_SYNC_BEGIN backend=%s\n", ggml_backend_name(backend));
     backend->iface.synchronize(backend);
+    fprintf(stderr, "AI_CHAT_BACKEND_SYNC_RETURNED backend=%s\n", ggml_backend_name(backend));
 }
@@ -538,20 +548,28 @@ void ggml_backend_event_record(ggml_backend_event_t event, ggml_backend_t backend) {
     GGML_ASSERT(backend);
     GGML_ASSERT(backend->iface.event_record != NULL);
 
+    fprintf(stderr, "AI_CHAT_BACKEND_EVENT_RECORD_BEGIN backend=%s\n", ggml_backend_name(backend));
     backend->iface.event_record(backend, event);
+    fprintf(stderr, "AI_CHAT_BACKEND_EVENT_RECORD_RETURNED backend=%s\n", ggml_backend_name(backend));
 }
 
 void ggml_backend_event_synchronize(ggml_backend_event_t event) {
     GGML_ASSERT(event);
     GGML_ASSERT(event->device->iface.event_synchronize);
 
+    fprintf(stderr, "AI_CHAT_BACKEND_EVENT_SYNC_BEGIN\n");
     event->device->iface.event_synchronize(event->device, event);
+    fprintf(stderr, "AI_CHAT_BACKEND_EVENT_SYNC_RETURNED\n");
 }
 
 void ggml_backend_event_wait(ggml_backend_t backend, ggml_backend_event_t event) {
     GGML_ASSERT(backend);
     GGML_ASSERT(backend->iface.event_wait != NULL);
 
+    fprintf(stderr, "AI_CHAT_BACKEND_EVENT_WAIT_BEGIN backend=%s\n", ggml_backend_name(backend));
     backend->iface.event_wait(backend, event);
+    fprintf(stderr, "AI_CHAT_BACKEND_EVENT_WAIT_RETURNED backend=%s\n", ggml_backend_name(backend));
 }
