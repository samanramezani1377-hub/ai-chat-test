<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="گفت‌وگوی صوتی"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#18212B"
        android:gravity="center" />

    <TextView
        android:id="@+id/widget_voice_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="برای یک نوبت صحبت لمس کن"
        android:textSize="12sp"
        android:textColor="#687684"
        android:maxLines="3"
        android:ellipsize="end" />

    <Button
        android:id="@+id/widget_voice_start"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="🎙  شروع صحبت"
        android:textAllCaps="false"
        android:backgroundTint="#245C8A"
        android:textColor="#FFFFFF" />
</LinearLayout>
